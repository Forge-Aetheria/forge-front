# Perfiles de entorno (mayor a menor precedencia): .env.local, .env.production, .env
# No commitees secretos. `NEXT_PUBLIC_*` queda expuesto al navegador.
#
# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Backend API (GraphQL)
# -----------------------------------------------------------------------------
# URL completa del endpoint GraphQL de forge-backend.
# Obligatoria en producción: el cliente falla si falta y NODE_ENV=production.
# Por defecto en desarrollo local: http://localhost:4000/graphql (o el puerto configurado en PORT del backend)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# -----------------------------------------------------------------------------
# E2E Mocks (MSW)
# -----------------------------------------------------------------------------
# Habilitar interceptación de red y base de datos simulada en memoria para desarrollo
# o pruebas E2E locales sin requerir que forge-backend o PostgreSQL estén levantados.
# Valores: true | false (por defecto: false)
NEXT_PUBLIC_ENABLE_E2E_MOCKS=false

# Verificación: npm run env:whoami [-- --json]
